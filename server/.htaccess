# SzigLet API — every request goes through the single front controller.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The application directory is never reachable over HTTP. Its own .htaccess
  # denies it as well; this is the belt to that pair of braces.
  RewriteRule ^app(/|$) - [F,L]

  # Anything that is not a real file becomes index.php. Because index.php is
  # itself a real file, the rewrite cannot loop.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Cache-Control "no-store"
</IfModule>
