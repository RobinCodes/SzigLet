{
  "name": "SzigLet",
  "short_name": "SzigLet",
  "description": "One shared flashcard library. Swipe to learn, test to be sure.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0a0b0e",
